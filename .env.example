# Copie para .env.local e preencha. Sem valor, a integração correspondente fica desligada.

# Endereço público do site (sitemap, robots, links compartilhados)
NEXT_PUBLIC_SITE_URL=https://cltudo.com.br

# E-mail de contato exibido na política de privacidade (LGPD)
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 (ex.: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense (ex.: ca-pub-1234567890123456) e o ID do bloco de anúncio
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Opcional: JSON remoto com as regras (ver src/rules/index.ts)
RULES_SOURCE_URL=
